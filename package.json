{
  "name": "dsh-ris-ide",
  "version": "1.8.6",
  "license": "MIT",
  "description": "RIS-IDE local dev panel for the DSH web GUI: live log tail, one-click start/stop of workspace programs, JDWP debugging, file tree + editor, and a standalone IDE window that carries no session history. \u00b7 DSH \u53f3\u4fa7\u680f\u672c\u5730\u5f00\u53d1\u9762\u677f\uff1a\u65e5\u5fd7\u5b9e\u65f6\u8ddf\u968f\u3001\u4e00\u952e\u542f\u505c\u672c\u5730\u7a0b\u5e8f\u3001Java \u65ad\u70b9\u8c03\u8bd5\u3001\u6587\u4ef6\u6811\u4e0e\u7f16\u8f91\u5668\u3001\u72ec\u7acb IDE \u7a97\u53e3\u3002",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ide",
    "devtools",
    "log-viewer",
    "spring-boot",
    "jdwp",
    "debugger",
    "file-tree",
    "code-editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ris-cloud/dsh-ris-ide.git"
  },
  "homepage": "https://gitee.com/riscloud/dsh-ris-ide#readme",
  "bugs": {
    "url": "https://gitee.com/riscloud/dsh-ris-ide/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "risd": "bin/risd.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/debug",
    "bin/run-with-log.sh",
    "bin/run-with-log.ps1",
    "test",
    "cordis.patch.yml",
    "README.md",
    "skills",
    "lib",
    "LICENSE",
    "bin",
    "lib/janitor.js"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test --test-timeout=120000 \"test/*.test.mjs\"",
    "build": "tsdown --config tsdown.config.mjs",
    "check:listing": "node bin/check-listing.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@lezer/highlight": "^1.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "@codemirror/lang-css": "^6.0.0",
    "@codemirror/lang-html": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/lang-sql": "^6.0.0",
    "@codemirror/lang-vue": "^6.0.0",
    "@codemirror/lang-xml": "^6.0.0",
    "@codemirror/lang-yaml": "^6.0.0"
  }
}
